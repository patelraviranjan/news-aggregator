# ===== Flask =====
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production-please
JWT_SECRET_KEY=change-me-jwt-secret-please

# ===== Database =====
# For local dev use sqlite; for production (Vercel!) use a real Postgres URL:
# postgresql://user:pass@host:5432/dbname
# Do NOT deploy to Vercel with sqlite:// -- Vercel's serverless filesystem
# isn't persistent/shared across invocations, so a SQLite file will not
# survive between the cron fetch and the page request that reads it, and
# the feed will silently stay empty forever. Free Postgres: Neon, Supabase,
# or Vercel Postgres (Storage tab in the Vercel dashboard) all work.
DATABASE_URL=sqlite:///news.db

# ===== Vercel Cron =====
# Required for /api/cron/fetch (the endpoint that populates the feed on
# Vercel, since the local APScheduler background job can't run there).
# Set this in Vercel's project env vars too -- Vercel then automatically
# sends it back as "Authorization: Bearer <value>" on every cron request,
# so the endpoint knows the request really came from Vercel Cron.
CRON_SECRET=

# ===== News APIs (OPTIONAL - app works without these via RSS) =====
NEWSAPI_KEY=
GNEWS_API_KEY=

# ===== Google OAuth (OPTIONAL) =====
GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

# ===== Mail =====
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@newsaggregator.local

# ===== Cache =====
# Simple in-memory cache is used by default. Set to redis://... to enable Redis.
CACHE_TYPE=SimpleCache
REDIS_URL=

# ===== Scheduler =====
FETCH_INTERVAL_MINUTES=1
